<!-- Файл на проекта: казва на .NET какъв тип е приложението и как да се компилира -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Основни настройки на проекта -->
  <PropertyGroup>
    <!-- Използваме .NET 8 (версия с дългосрочна поддръжка) -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Включваме проверки за null, за да хващаме грешки още при компилиране -->
    <Nullable>enable</Nullable>
    <!-- Автоматично добавя най-често използваните using директиви -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Име на пространството от имена по подразбиране -->
    <RootNamespace>CourtVision</RootNamespace>
  </PropertyGroup>

  <!-- Файловете с данни се копират при компилиране до изходната папка -->
  <ItemGroup>
    <!-- Всички JSON файлове от папката Data отиват до изпълнимия файл -->
    <None Update="Data\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
