@* Една награда за сезона: етикет и победител (нашият играч или реален играч) *@
@model AwardBox
@inject PhotoService Photos
@{
    // Наградата
    var a = Model.Winner;
}
<div class="sp-award @(a.IsYou ? "you" : "")">
    @* Името на наградата *@
    <small>@Model.Label</small>
    <div>
        @* Снимка: "YOU" за нашия играч или истинската снимка *@
        @if (a.IsYou)
        {
            <div class="ph" style="--pc:var(--orange)"><span>YOU</span></div>
        }
        else
        {
            @Photos.Face(a.Name, a.Id, "PG")
        }
        @* Име, отбор и статистики *@
        <div><b>@a.Name</b><span><span class="tb-badge" style="--tc:@Teams.Get(a.Team).Color">@a.Team</span> @a.Line</span></div>
    </div>
</div>
