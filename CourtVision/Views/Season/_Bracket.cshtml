@* Плейофната схема (bracket) за Запада и Изтока *@
@model SeasonState
@{
    var west = Model.IsEast ? Model.OtherBracket : Model.MyBracket;
    var east = Model.IsEast ? Model.MyBracket : Model.OtherBracket;
}
<div class="sp-vt">
    <button type="button" class="@(Model.IsEast ? "" : "on")" data-view="W">West</button>
    <button type="button" class="@(Model.IsEast ? "on" : "")" data-view="E">East</button>
</div>
@foreach (var (code, br) in new[] { ("W", west), ("E", east) })
{
    var columns = new List<(string Title, List<SeriesBox> Boxes)>
    {
        ("R1", br.FirstRound.Select(s => new SeriesBox(s, br.Seeds, Model.Team, 0)).ToList()),
        ("Semis", br.Semis.Select(s => new SeriesBox(s, br.Seeds, Model.Team, 1)).ToList()),
        ("Conf Finals", new List<SeriesBox> { new(br.ConferenceFinal, br.Seeds, Model.Team, 2) }),
        ("NBA Finals", new List<SeriesBox> { new(Model.Finals, Model.MyBracket.Seeds.Contains(Model.Finals.A) ? Model.MyBracket.Seeds : Model.OtherBracket.Seeds, Model.Team, 3) }),
    };
    if (code == "E") { columns.Reverse(); }
    <div class="sp-conf" data-conf="@code" hidden="@((code == "E") != Model.IsEast)">
        <div class="sp-brh">
            @foreach (var col in columns)
            {
                <h5>@col.Title</h5>
            }
        </div>
        <div class="sp-br">
            @foreach (var col in columns)
            {
                <div class="sp-col">
                    @foreach (var box in col.Boxes)
                    {
                        <partial name="~/Views/Season/_SeriesBox.cshtml" model="box" />
                    }
                </div>
            }
        </div>
    </div>
}
