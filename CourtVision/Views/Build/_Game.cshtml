@* Екранът на билда: барабани, оценките на завъртания играч, арена и OVR *@
@model BuildState
@inject BuildService Game
@inject PhotoService Photos
@{
    // Атрибутите на групата (Guard или Big)
    var attrs = Grades.For(Model.Group);
    // Броят попълнени атрибути
    var filled = Model.Taken.Count;
    // Завъртаният играч (или null)
    var cur = Model.Current is int ci ? Game.Player(ci) : null;
    // Цвят на рамката на снимките
    var pc = Model.Group == "g" ? "PG" : "C";
    // OVR до момента
    var ovr = BuildService.Overall(Model);
    // Свободните играчи по отбори (за бутона за респин на играч)
    var mates = Model.Team != null && Game.FreeByTeam(Model).TryGetValue(Model.Team, out var list) ? list.Count : 0;
    // Обиколката на кръга за OVR и колко от нея да е запълнена
    var circle = 2 * Math.PI * 54;
    var offset = circle * (1 - (ovr ?? 0) / 99.0 * (Model.Done ? 1 : Math.Max(.08, filled / 10.0)));
    // Позициите на етикетите в арената за всеки таб (в проценти)
    var tagSpots = new Dictionary<string, (int, int)[]>
    {
        ["skills"] = new[] { (30, 30), (70, 30), (30, 52), (70, 52), (50, 74) },  // 5 умения
        ["physical"] = new[] { (50, 14), (30, 72), (70, 72) },                    // 3 физически
        ["mental"] = new[] { (30, 30), (70, 30) },                                // 2 ментални
    };
    // Номерата на атрибутите в отворения таб
    var tabAttrs = Enumerable.Range(0, 10).Where(i => Grades.TabOf(i) == Model.Tab).ToList();
}
@* Един формуляр за целия екран *@
<form id="bform" method="post" data-ajax="#broot">
    @* Горната лента: режим, табове и Reset *@
    <div class="bp-top">
        <button type="submit" class="bp-mode" formaction="/Build/Menu" aria-label="Change mode"><small>@(Model.Group == "g" ? "PG · SG · SF" : "PF · C")</small><b>@(Model.Group == "g" ? "Guard" : "Big")</b><span>@(Model.Mode == "a" ? "All-Time" : "Current")</span>▾</button>
        <div class="bp-tabs" role="tablist">
            @foreach (var (key, label) in Grades.Tabs)
            {
                <button type="submit" formaction="/Build/Tab" name="tab" value="@key" role="tab" class="@(Model.Tab == key ? "on" : "")" aria-selected="@(Model.Tab == key ? "true" : "false")">@label</button>
            }
        </div>
        <button type="submit" class="bp-reset" formaction="/Build/Reset">↺ Reset</button>
    </div>

    <div class="bp-grid">
        @* Лявата колона *@
        <div class="bp-left">
            @* Ръст и тегло (от играча, от когото е копиран Size) *@
            @{
                // Атрибутът Size е на позиция 7
                var sizePlayer = Model.Taken.TryGetValue(7, out var sz) ? Game.Player(sz.PlayerIndex) : null;
            }
            <div class="bp-htwt"><div><small>HT</small><b>@(sizePlayer?.HeightText ?? "--")</b></div><div><small>WT</small><b>@(sizePlayer != null ? sizePlayer.Weight + " lb" : "--")</b></div></div>

            @* Двата барабана: отбор и играч *@
            <div class="bp-reels" id="bpReels">
                <div class="bp-reel">
                    <div class="bp-rh">TEAM</div>
                    @{ var reelTeams = BuildService.ReelTeams(cur != null ? Model.Team : null); }
                    @for (var k = 0; k < 5; k++)
                    {
                        // Средният ред е текущият, крайните са бледи
                        var cls = k == 2 ? "mid" : (k == 0 || k == 4) ? "far" : "";
                        <div class="bp-cell @cls" data-reel-team><b>@(cur != null ? reelTeams[k] : "–")</b><small>@(cur != null ? Teams.Get(reelTeams[k]).Nickname : "")</small></div>
                    }
                </div>
                <div class="bp-reel">
                    <div class="bp-rh">PLAYER</div>
                    @{ var reelPlayers = Game.ReelPlayers(Model); }
                    @for (var k = 0; k < 5; k++)
                    {
                        // Играчът в реда (или празно)
                        var rp = reelPlayers[k];
                        var cls = k == 2 ? "mid" : (k == 0 || k == 4) ? "far" : "";
                        <div class="bp-cell @cls" data-reel-player><b>@(rp?.Name.Split(' ')[0] ?? "–")</b><small>@(rp != null ? string.Join(" ", rp.Name.Split(' ').Skip(1)) : "")</small></div>
                    }
                </div>
            </div>

            @if (Model.Done)
            {
                @* Готов билд: нов билд *@
                <button type="submit" class="bp-spin" formaction="/Build/Reset">Build again</button>
            }
            else if (cur != null)
            {
                @* Има завъртан играч: двата респина *@
                <div class="bp-respins">
                    <button type="submit" class="bp-rs" formaction="/Build/Spin" name="kind" value="team" data-spin disabled="@(Model.TeamRespins <= 0)">Respin team <i>@Model.TeamRespins</i></button>
                    <button type="submit" class="bp-rs" formaction="/Build/Spin" name="kind" value="player" data-spin disabled="@(Model.PlayerRespins <= 0 || mates < 2)">Respin player <i>@Model.PlayerRespins</i></button>
                </div>
            }
            else
            {
                @* Няма завъртан играч: бутон Spin *@
                <button type="submit" class="bp-spin" formaction="/Build/Spin" name="kind" value="all" data-spin>Spin</button>
                <p class="bp-help">Spin to select an attribute for your build.</p>
            }

            @if (cur != null)
            {
                @* Картата на завъртания играч *@
                <div class="bp-card">
                    @Photos.Face(cur.Name, cur.Id, pc)
                    <div><b>@cur.Name</b><span>@Teams.Get(cur.Team).Name</span><small>@(cur.Mode == "a" ? cur.Years : cur.Rookie ? "Rookie · no NBA games yet" : "2025–26 season")</small></div>
                </div>
                @* Оценките му, групирани по табове; натискане копира оценката *@
                foreach (var (key, label) in Grades.Tabs)
                {
                    <div class="bp-sec">@label</div>
                    for (var i = 0; i < 10; i++)
                    {
                        if (Grades.TabOf(i) != key) { continue; } // Само атрибутите от този таб
                        var g = cur.Grades[i]; // Оценката на играча
                        <button type="submit" class="bp-attr" formaction="/Build/Take" name="attribute" value="@i" style="--gc:@Grades.Color(g)" disabled="@Model.Taken.ContainsKey(i)">
                            <span>@attrs[i].Label</span><span class="gr" style="--gc:@Grades.Color(g)">@Grades.Letters[g]</span>
                        </button>
                    }
                }
                <p class="bp-help">Click one open attribute to copy @cur.Name.Split(' ').Last()'s grade.</p>
            }
        </div>

        @* Арената с етикетите на отворения таб *@
        <div class="bp-arena">
            <div class="bp-floor"></div>
            @* Силуетът на играча *@
            <svg class="fig" viewBox="0 0 120 300" aria-hidden="true">
                <defs><linearGradient id="fg" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#1E2A44" /><stop offset="1" stop-color="#0B1020" /></linearGradient></defs>
                <g fill="url(#fg)" stroke="rgba(96,165,250,.6)" stroke-width="1.2">
                    <circle cx="60" cy="26" r="17" />                                          @* Глава *@
                    <path d="M34 52q26-10 52 0l10 70-12 4-6-46-4 50H46l-4-50-6 46-12-4z" />     @* Тяло и ръце *@
                    <path d="M42 130h36l4 90-4 66H66l-4-80-4 80H44l-4-66z" />                   @* Крака *@
                    <path d="M42 284h16v10H36zM66 284h16l6 10H66z" fill="#E11D2E" />             @* Обувки *@
                </g>
            </svg>
            @for (var k = 0; k < tabAttrs.Count; k++)
            {
                // Номерът на атрибута и къде стои етикетът
                var i = tabAttrs[k];
                var (left, top) = tagSpots[Model.Tab][k];
                // Попълнен ли е
                Model.Taken.TryGetValue(i, out var t);
                var tp = t != null ? Game.Player(t.PlayerIndex) : null;
                <div class="bp-tag @(t != null ? "filled" : "")" style="left:@left%;top:@top%;@(t != null ? $"--gc:{Grades.Color(t.Value)}" : "")">
                    <div class="th">@attrs[i].Label</div>
                    <div class="tb">
                        @if (t != null && tp != null)
                        {
                            @Photos.Face(tp.Name, tp.Id, pc)<span class="gr" style="--gc:@Grades.Color(t.Value)">@Grades.Letters[t.Value]</span><span class="who">@tp.Name.Split(' ').Last()<small>@tp.Team</small></span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Дясната колона: OVR и списъкът с атрибутите *@
        <div class="bp-right">
            <div class="ovr">
                @* Кръгът за OVR *@
                <svg viewBox="0 0 140 140"><circle class="ring-bg" cx="70" cy="70" r="54" /><circle class="ring-fg" cx="70" cy="70" r="54" stroke-dasharray="@circle.ToString("0.##")" stroke-dashoffset="@offset.ToString("0.##")" /><text class="ovr-l" x="70" y="48" text-anchor="middle">OVR</text><text class="ovr-n" x="70" y="88" text-anchor="middle">@(ovr?.ToString() ?? "–")</text></svg>
                @if (Model.Done)
                {
                    @* Тип на играча *@
                    <div class="bp-arch">@BuildService.Archetype(Model)</div>
                }
                else
                {
                    <div class="strong">@(filled > 0 ? "Keep building" : "Spin to start building")</div>
                    <div class="slotsleft">@(10 - filled) slots remaining</div>
                }
            </div>
            @if (Model.Done)
            {
                @* Готов билд: списък със снимки *@
                <div class="bp-done-list">
                    @for (var i = 0; i < 10; i++)
                    {
                        var t = Model.Taken[i];          // Копираният атрибут
                        var p = Game.Player(t.PlayerIndex); // От кой играч
                        <div class="bp-dl">@Photos.Face(p.Name, p.Id, pc)<div><small>@attrs[i].Label</small><b>@p.Name</b></div><span class="gr" style="--gc:@Grades.Color(t.Value)">@Grades.Letters[t.Value]</span></div>
                    }
                </div>
            }
            else
            {
                @* Списък с всички 10 атрибута и попълнените оценки *@
                <div class="statlist">
                    @for (var i = 0; i < 10; i++)
                    {
                        Model.Taken.TryGetValue(i, out var t);
                        <div><span>@attrs[i].Label</span>@if (t != null) {<b style="color:@Grades.Color(t.Value)">@Grades.Letters[t.Value] <em>@Game.Player(t.PlayerIndex).Name.Split(' ').Last()</em></b>} else {<b>–</b>}</div>
                    }
                </div>
            }
        </div>
    </div>
</form>

