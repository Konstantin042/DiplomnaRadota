@* Таблото на Salary Cap: горна лента, мрежата 5×5, бутоните и лентата на бюджета *@
@model SalaryState
@inject SalaryService Game
@inject SalaryLeaderboard Leaders
@{
    // Текущият ден
    var d = Model.Days[Model.Current];
    // Безкрайна игра ли е
    var isInf = d.Key == "inf";
    // Датата на деня (за безкрайната игра – днес)
    var date = isInf ? DateTime.Today : DateTime.ParseExact(d.Key, "yyyy-MM-dd", null);
    // Похарчените пари
    var spent = SalaryService.Spent(d);
    // Избрани ли са всички 5
    var all = SalaryService.AllPicked(d);
    // Над тавана ли сме
    var over = spent > d.Budget;
    // Заключен ли е билдът
    var locked = d.Result != null;
    // Колко още трябва да изберем
    var left = SalaryService.Columns.Length - d.Picks.Count;
    // Текстът на главния бутон
    var cta = locked ? "View Results →" : !all ? $"Pick {left} more" : over ? $"${spent - d.Budget}M over budget" : "Lock In Build →";
    // Може ли да се натисне главният бутон
    var canLock = locked || (all && !over);
    // Цветът на лентата на бюджета: червен над тавана, лилав точно на тавана, жълт близо до него, зелен иначе
    var barColor = over ? "#ef4444" : spent == d.Budget && all ? "#a855f7" : spent >= d.Budget - 10 ? "#f59e0b" : "#34d399";
    // Колко от лентата е запълнено (в проценти)
    var fill = Math.Min(1.0, spent / (double)d.Budget) * 100;
    // Идентификаторът на нашата сесия (за класацията)
    var me = Context.Session.Id;
}
<form id="sform" method="post" data-ajax="#sroot" class="sc @(d.Mode != "" ? "sc--" + d.Mode : "")">
    @if (Model.Menu != "")
    {
        @* Прозрачен фон: клик извън менюто го затваря *@
        <button type="submit" class="sc-backdrop" formaction="/Salary/Menu" name="menu" value="@Model.Menu" aria-label="Close menu"></button>
    }
    @* Горната лента: заглавие и трите бутона (power-ups, класация, дата) *@
    <div class="sc-header">
        <div class="sc-title">BUILD<span>-A-</span>PLAYER <span>SALARY</span></div>
        <div class="sc-icons">
            @* Power-ups: разбъркване и скаут (само ако са останали и билдът не е заключен) *@
            @if ((d.Shuffles > 0 || d.Scouts > 0) && !locked)
            {
                <div class="sc-pop">
                    <button type="submit" class="sc-icon @(Model.Menu == "power" ? "on" : "")" formaction="/Salary/Menu" name="menu" value="power" aria-label="Power-ups">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="4" /><circle cx="8" cy="8" r="1.4" /><circle cx="16" cy="8" r="1.4" /><circle cx="12" cy="12" r="1.4" /><circle cx="8" cy="16" r="1.4" /><circle cx="16" cy="16" r="1.4" /></svg>
                    </button>
                    @if (Model.Menu == "power")
                    {
                        @* Менюто с двете power-ups и броя им *@
                        <div class="sc-power">
                            <div class="sc-power-item">
                                <button type="submit" class="sc-circle @(d.Mode == "shuffle" ? "on" : "")" formaction="/Salary/Mode" name="mode" value="shuffle" disabled="@(d.Shuffles == 0)" aria-label="Shuffle">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /></svg><i>@d.Shuffles</i>
                                </button>
                                <small>SHUFFLE</small>
                            </div>
                            <div class="sc-power-item">
                                <button type="submit" class="sc-circle @(d.Mode == "scout" ? "on" : "")" formaction="/Salary/Mode" name="mode" value="scout" disabled="@(d.Scouts == 0)" aria-label="Scout">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg><i>@d.Scouts</i>
                                </button>
                                <small>SCOUT</small>
                            </div>
                        </div>
                    }
                </div>
            }
            @* Класацията (трофей) *@
            <div class="sc-pop">
                <button type="submit" class="sc-icon @(Model.Menu == "board" ? "on" : "")" formaction="/Salary/Menu" name="menu" value="board" aria-label="Top builds">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2z" /></svg>
                </button>
                @if (Model.Locked)
                {
                    @* Съобщение: класацията се отключва след като изиграем деня *@
                    <div class="sc-prompt" data-autohide>Play today's game to unlock</div>
                }
                @if (Model.Menu == "board")
                {
                    // Най-добрите билдове за деня (или за безкрайната игра)
                    var top = Leaders.Top(d.Key);
                    <div class="sc-drop sc-lb">
                        <div class="sc-drop-h">@(isInf ? "ALL-TIME TOP BUILDS" : date.ToString("MMM d").ToUpperInvariant() + "'S TOP BUILDS")</div>
                        @if (top.Count == 0)
                        {
                            <div class="sc-empty">No builds yet — be the first!</div>
                        }
                        @for (var i = 0; i < top.Count; i++)
                        {
                            // Един ред от класацията
                            var e = top[i];
                            <div class="sc-lb-row @(i == 0 ? "top" : "") @(e.Owner == me ? "you" : "")">
                                <div class="sc-lb-main"><b>@(i + 1)</b><span>@(e.Owner == me ? "You" : e.Name)</span><em>@e.Overall OVR</em>@if (e.Spare > 0) {<small>+$@(e.Spare)M</small>}</div>
                                <div class="sc-lb-picks">
                                    @foreach (var idx in e.Players)
                                    {
                                        // Играчът и снимката му
                                        var lp = Game.Player(idx);
                                        var url = Game.PhotoUrl(lp);
                                        <span style="--tc:@Teams.Get(lp.Team).Color" title="@lp.Name">@if (url != null) {<img src="@url" alt="@lp.Name" loading="lazy" />} else {<b>@PhotoService.Initials(lp.Name)</b>}</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            @* Датата: менюто с последните 10 дни и безкрайната игра *@
            <div class="sc-pop">
                <button type="submit" class="sc-date @(Model.Menu == "dates" ? "on" : "")" formaction="/Salary/Menu" name="menu" value="dates" aria-label="Choose a date">
                    @if (isInf)
                    {
                        <b>∞</b><small>INF</small>
                    }
                    else
                    {
                        <b>@date.Day</b><small>@date.ToString("MMM").ToUpperInvariant()</small>
                    }
                </button>
                @if (Model.Menu == "dates")
                {
                    <div class="sc-drop sc-dates">
                        @* Безкрайна игра: всяко натискане дава нова мрежа *@
                        <button type="submit" class="sc-date-item inf @(isInf ? "on" : "")" formaction="/Salary/Date" name="key" value="inf"><span>∞ Infinite</span>@if (isInf) {<small>tap to reset</small>}</button>
                        @* Последните 10 дни *@
                        @foreach (var day in SalaryService.RecentDates())
                        {
                            // Ключът на деня
                            var k = day.ToString("yyyy-MM-dd");
                            <button type="submit" class="sc-date-item @(!isInf && k == d.Key ? "on" : "")" formaction="/Salary/Date" name="key" value="@k"><span>@day.ToString("MMM d")</span>@if (Model.Days.TryGetValue(k, out var played) && played.Result != null) {<small>✓ @played.Result.Overall OVR</small>}</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* Съобщение, когато дневният билд вече е заключен *@
    @if (locked && !isInf)
    {
        <div class="sc-banner"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>Today's build is locked — come back tomorrow for a new lineup or play a previous date</div>
    }

    @* Мрежата: колона с цените отляво + 5 колони с категории *@
    <div class="sc-grid-wrap">
        <div class="sc-grid">
            @* Празна клетка в ъгъла *@
            <div></div>
            @* Заглавията на колоните (в режим разбъркване с бутон ⇅) *@
            @for (var c = 0; c < SalaryService.Columns.Length; c++)
            {
                var col = SalaryService.Columns[c];
                <div class="sc-col" style="--cc:@col.Color">
                    <span>@col.Label</span>
                    @if (d.Mode == "shuffle")
                    {
                        <button type="submit" class="sc-arrow" formaction="/Salary/Column" name="col" value="@c" aria-label="Shuffle @col.Label">⇅</button>
                    }
                </div>
            }
            @* Петте реда с цени *@
            @for (var r = 0; r < SalaryService.Prices.Length; r++)
            {
                @* Цената на реда (в режим разбъркване с бутон ⇄) *@
                <div class="sc-price">
                    <span>$@(SalaryService.Prices[r])M</span>
                    @if (d.Mode == "shuffle")
                    {
                        <button type="submit" class="sc-arrow" formaction="/Salary/Row" name="row" value="@r" aria-label="Shuffle the $@(SalaryService.Prices[r])M row">⇄</button>
                    }
                </div>
                for (var c = 0; c < SalaryService.Columns.Length; c++)
                {
                    // Играчът в клетката
                    var p = Game.Player(d.Grid[c][r]);
                    // Отборът му (цвят за фона)
                    var team = Teams.Get(p.Team);
                    // Избран ли е и има ли избран друг в колоната
                    var selected = d.Picks.TryGetValue(c, out var pr) && pr == r;
                    var dim = d.Picks.ContainsKey(c) && !selected;
                    // Току-що сменен ли е (за анимацията)
                    var flip = d.Flip.Contains($"{c}-{r}");
                    // Снимката му
                    var photo = Game.PhotoUrl(p);
                    // Първото име и фамилията
                    var first = p.Name.Split(' ')[0];
                    var last = string.Join(" ", p.Name.Split(' ').Skip(1));
                    <button type="submit" class="sc-card @(selected ? "sel" : "") @(dim ? "dim" : "") @(flip ? "flip" : "")" formaction="/Salary/Tap" name="cell" value="@($"{c}-{r}")" style="--tc:@team.Color;--fd:@((flip ? (d.Flip.IndexOf($"{c}-{r}") * 45) : 0))ms" disabled="@locked" aria-label="@p.Name, $@(SalaryService.Prices[r])M">
                        <span class="sc-visual">
                            <span class="sc-wm">@p.Team</span>
                            @if (photo != null)
                            {
                                <img src="@photo" alt="" loading="eager" />
                            }
                            else
                            {
                                <span class="sc-ini">@PhotoService.Initials(p.Name)</span>
                            }
                        </span>
                        <span class="sc-name"><small>@first</small><b>@last</b></span>
                        @if (d.Scouted.TryGetValue(p.Index, out var grade))
                        {
                            @* Оценката от скаута *@
                            <span class="sc-grade" style="--gc:@(grade == "S" ? "#a855f7" : grade.StartsWith("A") ? "#22c55e" : grade.StartsWith("B") ? "#60a5fa" : grade.StartsWith("C") ? "#f59e0b" : grade.StartsWith("D") ? "#f97316" : "#ef4444")"><b>@grade</b></span>
                        }
                    </button>
                }
            }
        </div>
        @* Подсказки за режимите *@
        @if (d.Mode == "shuffle")
        {
            <div class="sc-hint">⇅ column · ⇄ row<button type="submit" formaction="/Salary/Mode" name="mode" value="shuffle">Cancel</button></div>
        }
        else if (d.Mode == "scout")
        {
            <div class="sc-hint scout">Choose a player to scout<button type="submit" formaction="/Salary/Mode" name="mode" value="scout">Cancel</button></div>
        }
    </div>

    @* Долната част: бутоните и лентата на бюджета *@
    <div class="sc-footer">
        <div class="sc-btns">
            <a class="sc-back" asp-controller="Home" asp-action="Index">← Back</a>
            @if (canLock)
            {
                @* Обикновено изпращане (data-full): след заключване отиваме на страницата на сезона *@
                <button type="submit" class="sc-confirm @(locked ? "view" : "")" formaction="/Salary/Lock" data-full>@cta</button>
            }
            else
            {
                <button type="button" class="sc-confirm" disabled>@cta</button>
            }
        </div>
        @* Лентата: похарчено / таван *@
        <div class="sc-budget">
            <div class="sc-budget-l"><b style="color:@(over ? "#ef4444" : spent == d.Budget && all ? "#a855f7" : "var(--ink)")">$@(spent)M</b><span> / $@(d.Budget)M</span></div>
            <div class="sc-track"><i style="width:@fill.ToString("0.#")%;background:@barColor"></i></div>
        </div>
        @if (d.Result != null)
        {
            // Резултатът от заключения билд
            var res = d.Result;
            <div class="sc-result">
                <div><b>@res.Overall</b><small>Score</small></div>
                <div><b>@res.Ppg.ToString("0.0")</b><small>PPG</small></div>
                <div><b>@res.Apg.ToString("0.0")</b><small>APG</small></div>
                <div><b>@res.Rpg.ToString("0.0")</b><small>RPG</small></div>
                <div><b>@res.Team</b><small>Team</small></div>
            </div>
        }
    </div>
</form>
