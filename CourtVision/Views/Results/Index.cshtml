@* Класациите: първите 10 места във всяка игра (от таблицата GameResults) *@
@model List<LeaderboardBox>
@{
    ViewData["Title"] = "Leaderboards"; // Заглавие в раздела
    // Името на текущия посетител (за да отбележим неговия ред)
    var me = ResultService.PlayerName(Context);
    // Влязъл ли е
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<section class="view">
    @* Заглавие *@
    <div class="ghead">
        <div>
            <div class="label">All games</div>
            <h2>Leaderboards</h2>
            <p>The best result of every player in every game. Each finished game is saved in the database.</p>
        </div>
        @if (!signedIn)
        {
            @* Покана за регистрация *@
            <a class="btn sec" asp-controller="Account" asp-action="Register" asp-route-returnUrl="/Results">Sign up to get your name on the board</a>
        }
    </div>

    @* Една карта за всяка игра *@
    <div class="lb-grid">
        @foreach (var box in Model)
        {
            <div class="lb-card">
                <h3>@box.Game.Name</h3>
                <small class="lb-unit">@(box.Game.LowerIsBetter ? "fewest guesses to win" : "best " + box.Game.ScoreLabel)</small>
                @if (box.Rows.Count == 0)
                {
                    <p class="lb-empty">No results yet. Be the first!</p>
                }
                else
                {
                    <ol class="lb-list">
                        @for (var i = 0; i < box.Rows.Count; i++)
                        {
                            // Един ред: място, име, резултат, брой игри
                            var row = box.Rows[i];
                            <li class="@(i == 0 ? "top" : "") @(row.Name == me ? "you" : "")">
                                <b class="mono">@(i + 1)</b>
                                <span>@(row.Name == me ? row.Name + " (you)" : row.Name)</span>
                                <em class="mono">@row.Best</em>
                                <small>@row.Played @(row.Played == 1 ? "game" : "games")</small>
                            </li>
                        }
                    </ol>
                }
            </div>
        }
    </div>
</section>
