@* Страницата за регистрация *@
@model RegisterModel
@{
    ViewData["Title"] = "Sign up";
}
<section class="view auth">
    <div class="auth-card">
        <div class="label">Account</div>
        <h2>Create an account</h2>
        <p class="auth-sub">Only a username and a password. Your games are saved in the database under your name, and you can play without an account too.</p>

        <form asp-controller="Account" asp-action="Register" method="post" class="auth-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="auth-errors"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <label class="field">
                <span>Username</span>
                <input asp-for="UserName" autocomplete="username" autofocus />
                <small>3 to 20 letters, numbers, dots, dashes or underscores.</small>
                <span asp-validation-for="UserName" class="field-err"></span>
            </label>
            <label class="field">
                <span>Password</span>
                <input asp-for="Password" autocomplete="new-password" />
                <small>At least 6 characters.</small>
                <span asp-validation-for="Password" class="field-err"></span>
            </label>
            <label class="field">
                <span>Repeat password</span>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-err"></span>
            </label>
            <button type="submit" class="btn wide">Sign up</button>
        </form>

        <p class="auth-alt">Already have an account? <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
    </div>
</section>
