@* Общият шаблон: горното меню, съдържанието на страницата и долната лента *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Current(string c, string a = "Index") => (c == controller && (a == action || c != "Home")).ToString().ToLower();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Court Vision</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@@700;800;900&family=Fira+Sans:wght@@400;500;600;700;800&family=JetBrains+Mono:wght@@500;700&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @* Прилага запазените настройки преди страницата да се покаже, за да не "примигва" *@
    <script>try{var s=JSON.parse(localStorage.getItem("cv-settings")||"{}"),r=document.documentElement;if(s.motion===false)r.classList.add("no-motion");if(s.light)r.classList.add("light")}catch(e){}</script>
</head>
<body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <symbol id="ball" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="46" fill="#D62839" stroke="#7F1020" stroke-width="4" />
                <path d="M50 4v92M4 50h92M18 18c18 14 18 50 0 64M82 18c-18 14-18 50 0 64" fill="none" stroke="#5C0A16" stroke-width="3.5" />
                <circle cx="35" cy="30" r="14" fill="#fff" opacity=".12" />
            </symbol>
        </defs>
    </svg>

    @* Горното меню *@
    <header>
        <div class="wrap bar">
            <a class="mini-logo" asp-controller="Home" asp-action="Index" aria-label="Court Vision home">
                <svg class="ball"><use href="#ball" /></svg><span class="cap">Court Vision</span>
            </a>
            @* Зъбното колело: настройки, пазят се в браузъра (localStorage) *@
            <div class="set-wrap">
            <button class="gear" id="setBtn" aria-label="Settings" title="Settings" aria-expanded="false" aria-controls="setMenu"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M19.71 9.87 L22.36 10.31 L22.36 13.69 L19.71 14.13 L18.96 15.94 L20.52 18.13 L18.13 20.52 L15.94 18.96 L14.13 19.71 L13.69 22.36 L10.31 22.36 L9.87 19.71 L8.06 18.96 L5.87 20.52 L3.48 18.13 L5.04 15.94 L4.29 14.13 L1.64 13.69 L1.64 10.31 L4.29 9.87 L5.04 8.06 L3.48 5.87 L5.87 3.48 L8.06 5.04 L9.87 4.29 L10.31 1.64 L13.69 1.64 L14.13 4.29 L15.94 5.04 L18.13 3.48 L20.52 5.87 L18.96 8.06Z M12 8.6a3.4 3.4 0 1 0 0 6.8a3.4 3.4 0 1 0 0-6.8Z"/></svg></button>
            <div class="set-menu" id="setMenu" role="dialog" aria-label="Settings" hidden>
              <h4>SETTINGS</h4>
              <div class="set-row"><span>Theme<small>Switches with a slow wave</small></span><div class="seg" role="group" aria-label="Theme"><button data-theme="0">Dark</button><button data-theme="1">Light</button></div></div>
              <div class="set-row"><span>Animations<small>Spinning reels and moving effects</small></span><button class="sw" role="switch" data-set="motion" aria-label="Animations"></button></div>
              <div class="set-row"><span>"How to play" pop-up<small>Shows the rules when a game opens</small></span><button class="sw" role="switch" data-set="help" aria-label="How to play pop-up"></button></div>
              <button class="set-reset" id="setReset">Reset to default</button>
            </div>
            </div>
            <nav class="tabs" aria-label="Sections">
                <a class="tab" asp-controller="Home" asp-action="Index" aria-current="@Current("Home")">Home</a>
                <a class="tab" asp-controller="Home" asp-action="Nba101" aria-current="@Current("Home", "Nba101")">NBA 101</a>
                <a class="tab" asp-controller="Challenge" asp-action="Index" aria-current="@Current("Challenge")">82-0</a>
                <a class="tab" asp-controller="Build" asp-action="Index" aria-current="@((controller is "Build" or "Season").ToString().ToLower())">Build-a-Player</a>
                <a class="tab" asp-controller="HigherLower" asp-action="Index" aria-current="@Current("HigherLower")">Higher or Lower</a>
                <a class="tab" asp-controller="Salary" asp-action="Index" aria-current="@Current("Salary")">Salary Cap Game</a>
                <a class="tab" asp-controller="Quiz" asp-action="Index" aria-current="@Current("Quiz")">Position Quiz</a>
                <a class="tab" asp-controller="Guess" asp-action="Index" aria-current="@Current("Guess")">Guess the Player</a>
            </nav>
            <div class="acct">
                <a class="acct-btn" asp-controller="Results" asp-action="Index" aria-current="@Current("Results")" title="Leaderboards" aria-label="Leaderboards">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10v3h4v2a5 5 0 0 1-4.6 5A5 5 0 0 1 13 16.9V19h3v2H8v-2h3v-2.1A5 5 0 0 1 7.6 13 5 5 0 0 1 3 8V6h4V3Zm0 5H5a3 3 0 0 0 2 2.8V8Zm10 0v2.8A3 3 0 0 0 19 8h-2Z" fill="currentColor" /></svg>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var userName = User.Identity.Name ?? "?";
                    <a class="acct-user" asp-controller="Account" asp-action="Profile" aria-current="@Current("Account", "Profile")" title="Your profile">
                        <b>@(userName.Substring(0, 1).ToUpperInvariant())</b><span>@userName</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="acct-out">
                        <button type="submit" title="Log out" aria-label="Log out">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5v-2H7V6h3V4Zm6.6 3.4L15.2 8.8 17.4 11H9v2h8.4l-2.2 2.2 1.4 1.4L21.2 12l-4.6-4.6Z" fill="currentColor" /></svg>
                        </button>
                    </form>
                }
                else
                {
                    <a class="acct-login" asp-controller="Account" asp-action="Login">Log in</a>
                }
            </div>
        </div>
    </header>

    @* Основното съдържание на всяка страница *@
    <main class="wrap">
        @RenderBody()
    </main>

    <div class="modal" id="modal" hidden>
        <div class="dlg" role="dialog" aria-modal="true" id="dlg"></div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
