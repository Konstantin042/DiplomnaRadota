@* Общият шаблон: горното меню, съдържанието на страницата и долната лента *@
@{
    // Текущият контролер (за да отбележим активния линк в менюто)
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    // Текущото действие
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    // Помощна функция: "true", ако линкът е за текущата страница
    string Current(string c, string a = "Index") => (c == controller && (a == action || c != "Home")).ToString().ToLower();
}
<!doctype html>
<html lang="en">
<head>
    @* Кодировка на страницата *@
    <meta charset="utf-8">
    @* Правилен мащаб на телефон *@
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    @* Заглавие в раздела на браузъра *@
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Court Vision</title>
    @* Връзка към Google Fonts за по-бързо зареждане *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    @* Шрифтовете: Big Shoulders Display (заглавия), Fira Sans (текст), JetBrains Mono (числа) *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@@700;800;900&family=Fira+Sans:wght@@400;500;600;700;800&family=JetBrains+Mono:wght@@500;700&display=swap">
    @* Нашият CSS файл (asp-append-version добавя версия, за да не се кешира стар файл) *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    @* Скрита SVG дефиниция на топката (използва се в логото) *@
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <symbol id="ball" viewBox="0 0 100 100">
                @* Червеният кръг на топката *@
                <circle cx="50" cy="50" r="46" fill="#D62839" stroke="#7F1020" stroke-width="4" />
                @* Линиите на топката *@
                <path d="M50 4v92M4 50h92M18 18c18 14 18 50 0 64M82 18c-18 14-18 50 0 64" fill="none" stroke="#5C0A16" stroke-width="3.5" />
                @* Отблясък *@
                <circle cx="35" cy="30" r="14" fill="#fff" opacity=".12" />
            </symbol>
        </defs>
    </svg>

    @* Горното меню *@
    <header>
        <div class="wrap bar">
            @* Логото води към началната страница *@
            <a class="mini-logo" asp-controller="Home" asp-action="Index" aria-label="Court Vision home">
                <svg class="ball"><use href="#ball" /></svg><span class="cap">Court Vision</span>
            </a>
            @* Линковете към секциите *@
            <nav class="tabs" aria-label="Sections">
                <a class="tab" asp-controller="Home" asp-action="Index" aria-current="@Current("Home")">Home</a>
                <a class="tab" asp-controller="Home" asp-action="Nba101" aria-current="@Current("Home", "Nba101")">NBA 101</a>
                <a class="tab" asp-controller="Challenge" asp-action="Index" aria-current="@Current("Challenge")">82-0</a>
                <a class="tab" asp-controller="Build" asp-action="Index" aria-current="@((controller is "Build" or "Season").ToString().ToLower())">Build-a-Player</a>
                <a class="tab" asp-controller="Quiz" asp-action="Index" aria-current="@Current("Quiz")">Position Quiz</a>
            </nav>
        </div>
    </header>

    @* Основното съдържание на всяка страница *@
    <main class="wrap">
        @RenderBody()
    </main>

    @* Долната лента с източниците *@
    <footer>
        Court Vision · Diploma project · Stats from Basketball-Reference; Build-a-Player grades are calculated from those stats for teaching purposes.
        Not affiliated with the NBA.
    </footer>

    @* Прозорецът "How to play" (съдържанието се попълва от всяка игра) *@
    <div class="modal" id="modal" hidden>
        <div class="dlg" role="dialog" aria-modal="true" id="dlg"></div>
    </div>

    @* Общият JavaScript (меню, прозорци, формуляри без презареждане) *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Допълнителен JavaScript за конкретната страница *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
